# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Configuração do PostgreSQL no seu Servidor Próprio (187.127.12.215)
POSTGRES_USER=TI
POSTGRES_PASSWORD=Gran1010!
POSTGRES_DB=Gran7
PGHOST=187.127.12.215
PGPORT=5431
DATABASE_URL=postgresql://TI:Gran1010!@187.127.12.215:5431/Gran7

# ALLOWED_EMAIL_DOMAINS: domínios de e-mail autorizados a logar via Google (login/api/auth/sync).
